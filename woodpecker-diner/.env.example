# Optioneel: endpoint waar het reserveringsformulier de aanvraag naartoe post
# (bijvoorbeeld een Odoo-webhook). De variabele wordt tijdens de build in de
# pagina gebakken, dus na wijzigen opnieuw builden. Het endpoint moet CORS voor
# het domein van de site toestaan.
#
# Zonder deze variabele opent het formulier een vooringevulde mail.
NEXT_PUBLIC_RESERVATIONS_WEBHOOK_URL=
